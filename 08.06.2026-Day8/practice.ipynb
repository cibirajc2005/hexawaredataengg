df = df.withColumn(
    "total_amount",
    col("quantity") * col("price")
)
     

df = df.withColumn(
    "discount",
    col("total_amount") * 0.10
)
     

df = df.withColumn(
    "final_amount",
    col("total_amount") - col("discount")
)
     

df = df.withColumnRenamed(
    "customer_name",
    "customer"
)
     

df = df.withColumnRenamed(
    "order_status",
    "status"
)
     

df.agg(
    sum("total_amount").alias("Total Revenue")
).show()
     
